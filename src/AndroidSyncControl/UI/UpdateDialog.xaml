<Window x:Class="AndroidSyncControl.UI.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Update.Title}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFFFFF"
        Foreground="#0F172A"
        FontFamily="Segoe UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Changelog -->
            <RowDefinition Height="Auto"/> <!-- Progress -->
            <RowDefinition Height="Auto"/> <!-- Footer actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header (Product Name + Version + Pill Tag) -->
        <Border Grid.Row="0" Padding="20,18,20,14" Background="#FFFFFF">
            <StackPanel Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title & Version -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txt_product_version" Text="AndroidSyncControl 1.2.0" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Minimal Pill Badge -->
                    <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="txt_badge" Text="{DynamicResource Str.Update.Available}" FontSize="11" FontWeight="Medium" Foreground="#2563EB"/>
                    </Border>
                </Grid>

                <!-- Subtitle: Current Version & Package Size -->
                <TextBlock x:Name="txt_version_info" Text="1.0.0 → 1.2.0 • 45.0 MB" FontSize="12" Foreground="#64748B" Margin="23,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Subtle Divider -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#F1F5F9" Margin="20,0,20,0"/>

        <!-- 2. Changelog Section -->
        <StackPanel Grid.Row="1" Margin="20,12,20,12">
            <TextBlock Text="{DynamicResource Str.Update.WhatsNew}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
            
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" MaxHeight="140">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ic_changelog">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Foreground="#3B82F6" FontWeight="Bold" FontSize="11" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#334155" FontSize="12" LineHeight="17" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- 3. Progress Section (Hidden initially) -->
        <StackPanel x:Name="panel_progress" Grid.Row="2" Margin="20,0,20,12" Visibility="Collapsed">
            <ProgressBar x:Name="pb_download" Height="4" Minimum="0" Maximum="100" Value="0"
                         Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0"/>
            <TextBlock x:Name="txt_progress_status" Text="{DynamicResource Str.Update.Downloading}" FontSize="11" Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 4. Footer Actions (Clean minimal buttons) -->
        <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_later" Content="{DynamicResource Str.Update.Later}" Height="30" Padding="14,0" Margin="0,0,8,0"
                        Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#475569"
                        Click="btn_later_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="btn_update" Content="{DynamicResource Str.Update.Now}" Height="30" Padding="16,0"
                        Background="#2563EB" BorderBrush="#2563EB" BorderThickness="1" Foreground="#FFFFFF"
                        FontWeight="SemiBold" Click="btn_update_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
