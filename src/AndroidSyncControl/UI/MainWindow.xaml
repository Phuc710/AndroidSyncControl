<Window x:Class="AndroidSyncControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:ctrl="clr-namespace:AndroidSyncControl.UI.Controls"
        mc:Ignorable="d"
        Title="AndroidSyncControl" 
        Icon="pack://application:,,,/Resources/appicon.ico"
        Height="780" Width="615" MinWidth="380" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFFFFF"
        Foreground="#1E293B"
        TextOptions.TextFormattingMode="Display"
        StateChanged="Window_StateChanged">

    <!-- Clean Unified Workspace: Live Phone Screen (Left) + Attached Sidebar (Right) -->
    <Grid x:Name="mainGrid" Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <!-- Phone column (fills available width, naturally 9:16 ratio) -->
            <ColumnDefinition Width="*"/>
            <!-- Dedicated Clean Sidebar -->
            <ColumnDefinition Width="185"/>
        </Grid.ColumnDefinitions>

        <!-- Left Area: Live Phone Screen Canvas (Embedded) OR Minimal White Connection Screen -->
        <Grid Grid.Column="0" Background="#0F172A">
            <!-- 1. Live Scrcpy Screen Canvas (Visible when connected) -->
            <WindowsFormsHost x:Name="wfHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
                <wf:Panel x:Name="scrcpyPanel" BackColor="Black"/>
            </WindowsFormsHost>

            <!-- 2. Clean Minimal White Connection Screen -->
            <Grid x:Name="overlayPanel" Visibility="Visible" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Margin="24">
                    
                    <!-- Logo plain — no shadow, no border -->
                    <Image Source="pack://application:,,,/Resources/phone_connect.png"
                           Width="125" Height="125" Margin="0,0,0,16" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Title -->
                    <TextBlock x:Name="txtStatusTitle" 
                               Text="Connect your Android device" 
                               FontSize="17" FontWeight="SemiBold" Foreground="#1E293B" 
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Description / Instructions -->
                    <TextBlock x:Name="txtStatusDetail" 
                               Text="Connect your phone via USB and make sure&#x0a;USB debugging is enabled." 
                               FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="19"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Subtle Status Indicator (Dot + Text) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Ellipse x:Name="statusDot" Width="7" Height="7" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtStatusState" Text="Searching for device..." 
                                   FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Smooth Circular Spinner -->
                    <Grid x:Name="progressBarStatus" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,0">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="spinnerRotate" CenterX="16" CenterY="16" Angle="0"/>
                        </Grid.RenderTransform>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="spinnerRotate"
                                            Storyboard.TargetProperty="Angle"
                                            From="0" To="360"
                                            Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <!-- Ring track -->
                        <Ellipse Width="32" Height="32"
                                 Stroke="#E2E8F0" StrokeThickness="3"
                                 Fill="Transparent"/>
                        <!-- Spinner arc — drawn as a thin Path arc segment -->
                        <Path x:Name="spinnerArc" Fill="Transparent" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Stroke>
                                <SolidColorBrush x:Name="spinnerBrush" Color="#2563EB"/>
                            </Path.Stroke>
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="16,1" IsClosed="False">
                                        <ArcSegment Point="31,16"
                                                    Size="15,15"
                                                    SweepDirection="Clockwise"
                                                    IsLargeArc="False"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Clean Right Sidebar matching reference design -->
        <ctrl:ShopeeSidebar x:Name="shopeeSidebar" Grid.Column="1"/>
    </Grid>
</Window>
