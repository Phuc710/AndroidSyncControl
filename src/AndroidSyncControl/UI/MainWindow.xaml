<Window x:Class="AndroidSyncControl.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:ctrl="clr-namespace:AndroidSyncControl.UI.Controls"
        mc:Ignorable="d"
        Title="AndroidSyncControl - Phone Screen &amp; Device Manager" 
        Icon="pack://application:,,,/Resources/appicon.ico"
        Height="780" Width="615" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFFFFF"
        Foreground="#1E293B"
        TextOptions.TextFormattingMode="Display"
        StateChanged="Window_StateChanged">

    <!-- Clean Unified Workspace: Live Phone Screen (Left) + Attached Sidebar (Right) -->
    <Grid x:Name="mainGrid" Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <!-- Phone column (fills available width, naturally 9:16 ratio) -->
            <ColumnDefinition Width="*"/>
            <!-- Dedicated Clean Sidebar -->
            <ColumnDefinition Width="185"/>
        </Grid.ColumnDefinitions>

        <!-- Left Area: Live Phone Screen Canvas (Embedded) OR Minimal White Connection Screen -->
        <Grid Grid.Column="0" Background="#FFFFFF">
            <!-- 1. Live Scrcpy Screen Canvas (Visible when connected) -->
            <WindowsFormsHost x:Name="wfHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
                <wf:Panel x:Name="scrcpyPanel" BackColor="Black"/>
            </WindowsFormsHost>

            <!-- 2. Clean Minimal White Connection Screen -->
            <Grid x:Name="overlayPanel" Visibility="Visible" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Margin="24">
                    
                    <!-- Application Logo (64x64, crisp high-quality rendering) -->
                    <Border Width="64" Height="64" CornerRadius="14" Margin="0,0,0,16" HorizontalAlignment="Center"
                            ClipToBounds="True" Background="Transparent">
                        <Image Source="pack://application:,,,/Resources/AndroidSyncControl_Icon_1024x1024.png"
                               Width="64" Height="64" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock x:Name="txtStatusTitle" 
                               Text="Connect your Android device" 
                               FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" 
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Description / Instructions -->
                    <TextBlock x:Name="txtStatusDetail" 
                               Text="Connect your phone via USB and make sure&#x0a;USB debugging is enabled." 
                               FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="19"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Subtle Status Indicator (Dot + Text) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Ellipse x:Name="statusDot" Width="7" Height="7" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtStatusState" Text="Searching for device..." 
                                   FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Subtle Loading Line (Slim, clean, minimal) -->
                    <ProgressBar x:Name="progressBarStatus" Height="2" Width="140" 
                                 IsIndeterminate="True" BorderThickness="0"
                                 Foreground="#2563EB" Background="#E2E8F0"
                                 HorizontalAlignment="Center" Margin="0,0,0,22"/>

                    <!-- Retry Button (Professional Windows desktop utility style) -->
                    <Button x:Name="btnRetry" Content="Retry" Click="BtnRetryNow_Click"
                            Width="84" Height="30" HorizontalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsEnabled" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="bdr" Property="Background" Value="#F1F5F9"/>
                                                    <Setter TargetName="bdr" Property="BorderBrush" Value="#94A3B8"/>
                                                </MultiTrigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsEnabled" Value="True"/>
                                                        <Condition Property="IsPressed" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="bdr" Property="Background" Value="#E2E8F0"/>
                                                    <Setter TargetName="bdr" Property="BorderBrush" Value="#64748B"/>
                                                </MultiTrigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                    <Setter TargetName="bdr" Property="Background" Value="#F8FAFC"/>
                                                    <Setter TargetName="bdr" Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Clean Right Sidebar matching reference design -->
        <ctrl:ShopeeSidebar x:Name="shopeeSidebar" Grid.Column="1"/>
    </Grid>
</Window>
