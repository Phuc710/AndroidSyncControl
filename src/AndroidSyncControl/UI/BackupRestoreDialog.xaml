<Window x:Class="AndroidSyncControl.UI.BackupRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Backup.Title}"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFFFFF"
        Foreground="#0F172A"
        FontFamily="Segoe UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Modern Dialog Button Base -->
        <Style x:Key="DlgBtnBase" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="DlgPrimaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtnBase}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A7F3D0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A7F3D0"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgSecondaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtnBase}">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgDangerBtn" TargetType="Button" BasedOn="{StaticResource DlgBtnBase}">
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="Foreground" Value="#E11D48"/>
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE4E6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FDA4AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FECDD3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Action toolbar -->
            <RowDefinition Height="*"/>    <!-- 2: Backup List -->
            <RowDefinition Height="Auto"/> <!-- 3: Progress & Status -->
            <RowDefinition Height="Auto"/> <!-- 4: Footer Close Button -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="&#xE775;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{DynamicResource Str.Backup.Title}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource Str.Backup.Desc}" FontSize="11.5" Foreground="#64748B"/>
        </StackPanel>

        <!-- 1. Action Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="btnCreateBackup" Style="{StaticResource DlgPrimaryBtn}" Click="btnCreateBackup_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Str.Backup.CreateBtn}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnOpenFolder" Style="{StaticResource DlgSecondaryBtn}" Content="{DynamicResource Str.Backup.OpenFolder}" Margin="0,0,6,0" Click="btnOpenFolder_Click"/>
                <Button x:Name="btnRefresh" Style="{StaticResource DlgSecondaryBtn}" Content="↻" Width="32" Padding="0" Click="btnRefresh_Click" ToolTip="Làm mới danh sách"/>
            </StackPanel>
        </Grid>

        <!-- 2. Backups List -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
            <Grid>
                <!-- Empty state -->
                <TextBlock x:Name="txtEmpty" Text="{DynamicResource Str.Backup.NoBackups}" 
                           FontSize="12" Foreground="#94A3B8" TextAlignment="Center" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" 
                           Margin="24" TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- List of backups -->
                <ListBox x:Name="lstBackups" Background="Transparent" BorderThickness="0" Padding="6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0" Background="#ECFDF5" CornerRadius="4" Width="34" Height="34" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0">
                                            <Run Text="Android ID: "/><Run Text="{Binding AndroidId}" FontWeight="Medium" Foreground="#2563EB"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Str.Backup.RestoreBtn}" Height="28" Padding="10,0" FontSize="11" 
                                                Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                                                Cursor="Hand" Margin="0,0,6,0" Click="btnItemRestore_Click" Tag="{Binding}"/>
                                        <Button Content="✕" Height="28" Width="28" Padding="0" FontSize="11"
                                                Background="#FFF1F2" Foreground="#E11D48" BorderBrush="#FECDD3" BorderThickness="1"
                                                Cursor="Hand" Click="btnItemDelete_Click" Tag="{Binding}" ToolTip="Xóa bản sao lưu"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 3. Progress & Status -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <ProgressBar x:Name="pbProgress" Height="2.5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,6" Foreground="#10B981"/>
            <TextBlock x:Name="txtStatus" Text="" FontSize="11.5" FontWeight="Medium" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 4. Footer -->
        <Grid Grid.Row="4">
            <Button Content="Đóng" Style="{StaticResource DlgSecondaryBtn}" HorizontalAlignment="Right" Width="80" Click="btnClose_Click"/>
        </Grid>
    </Grid>
</Window>
