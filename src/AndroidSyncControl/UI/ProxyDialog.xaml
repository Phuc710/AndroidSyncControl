<Window x:Class="AndroidSyncControl.UI.ProxyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Proxy.Title}"
        Width="490" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFFFFF"
        Foreground="#0F172A"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Modern Dialog Button Base -->
        <Style x:Key="DlgBtnBase" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="DlgPrimaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtnBase}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#93C5FD"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgSecondaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtnBase}">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgDangerBtn" TargetType="Button" BasedOn="{StaticResource DlgBtnBase}">
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="Foreground" Value="#E11D48"/>
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE4E6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FDA4AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FECDD3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FFF1F2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#FDA4AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header & Current status card -->
            <RowDefinition Height="Auto"/> <!-- 1: Form Inputs -->
            <RowDefinition Height="Auto"/> <!-- 2: Status / Feedback message -->
            <RowDefinition Height="Auto"/> <!-- 3: Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 0. Header & Status Card -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#EFF6FF" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.Proxy.Title}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Cấu hình HTTP/HTTPS Proxy cho điện thoại qua ADB" FontSize="11.5" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>

            <!-- Status Card -->
            <Border x:Name="bdrStatusCard" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="dotProxyStatus" Width="10" Height="10" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.Proxy.CurrentState}" FontSize="10.5" Foreground="#64748B" FontWeight="Medium"/>
                        <TextBlock x:Name="txtCurrentProxy" Text="Đang kiểm tra trạng thái..." FontSize="13" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="btnRefreshStatus" Style="{StaticResource DlgSecondaryBtn}" Height="30" Width="30" Padding="0" FontSize="13" Click="btnRefreshStatus_Click" Content="↻" ToolTip="Làm mới trạng thái"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 1. Form Inputs -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str.Proxy.HostLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="txtHost" Height="36" Padding="10,6" FontSize="13" 
                         VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,10,0"
                         TextChanged="txtHost_TextChanged"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Str.Proxy.PortLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPort" Height="36" Padding="10,6" FontSize="13" 
                         VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                         MaxLength="5"/>
            </Grid>
        </Border>

        <!-- 2. Status message feedback -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <ProgressBar x:Name="pbProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" Foreground="#2563EB"/>
            <TextBlock x:Name="txtFeedback" Text="" FontSize="12" FontWeight="Medium" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 3. Action Buttons (Enlarged, Clear & Prominent) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Test Connection Button -->
            <Button Grid.Column="0" x:Name="btnTestIp" Style="{StaticResource DlgSecondaryBtn}" Click="btnTestIp_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE709;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Str.Proxy.TestIpBtn}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Disable / Clear Proxy Button -->
                <Button x:Name="btnDisableProxy" Style="{StaticResource DlgDangerBtn}" Margin="0,0,10,0" Click="btnDisableProxy_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Str.Proxy.DisableBtn}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Apply Proxy Button -->
                <Button x:Name="btnApplyProxy" Style="{StaticResource DlgPrimaryBtn}" Click="btnApplyProxy_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Str.Proxy.ApplyBtn}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
