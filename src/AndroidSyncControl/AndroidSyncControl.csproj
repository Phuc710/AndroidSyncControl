<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<Platforms>x64</Platforms>
		<ApplicationIcon>Resources\appicon.ico</ApplicationIcon>

		<!-- Versioning & Metadata (Inherited from root Directory.Build.props -> VERSION) -->
		<Product>AndroidSyncControl</Product>
		<Company>AndroidSyncControl</Company>
		<Description>High-performance Android Screen Mirroring &amp; Automation Platform</Description>

		<!-- Production Packaging Defaults -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
		<IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
		<!-- Embedded so it can also be used as the WPF Window.Icon (taskbar / alt-tab). -->
		<Resource Include="Resources\appicon.ico" />
		<Resource Include="Resources\phone_connect.png" />
		<Resource Include="Resources\logo.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpicyTaco.AutoGrid" Version="1.2.29" />
		<PackageReference Include="TqkLibrary.Adb.Runtimes" Version="33.0.2.2" />
		<PackageReference Include="TqkLibrary.AdbDotNet" Version="1.0.0-build2022070800" />
		<PackageReference Include="TqkLibrary.WpfUi" Version="1.0.0-build2022050602" />
	</ItemGroup>

</Project>
