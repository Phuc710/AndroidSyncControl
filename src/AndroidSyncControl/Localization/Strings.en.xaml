    <sys:String x:Key="Str.Proxy.Title">Device Proxy Manager</sys:String>
    <sys:String x:Key="Str.Proxy.CurrentState">Current status:</sys:String>
    <sys:String x:Key="Str.Proxy.Direct">Direct (No Proxy)</sys:String>
    <sys:String x:Key="Str.Proxy.Active">Active: {0}</sys:String>
    <sys:String x:Key="Str.Proxy.HostLabel">IP Address / Host:</sys:String>
    <sys:String x:Key="Str.Proxy.PortLabel">Port:</sys:String>
    <sys:String x:Key="Str.Proxy.DisableBtn">Disable / Clear Proxy</sys:String>
    <sys:String x:Key="Str.Proxy.ApplyBtn">Apply Proxy</sys:String>
    <sys:String x:Key="Str.Proxy.TestIpBtn">Test IP</sys:String>
    <sys:String x:Key="Str.Proxy.Testing">Testing network connection...</sys:String>
    <sys:String x:Key="Str.Proxy.TestSuccess">Current IP: {0}</sys:String>
    <sys:String x:Key="Str.Proxy.TestFailed">Cannot connect to internet via this proxy</sys:String>

    <!-- ================= Backup / Restore Dialog ================= -->
    <sys:String x:Key="Str.Backup.Title">Shopee Backup &amp; Restore</sys:String>
    <sys:String x:Key="Str.Backup.Desc">Manage backups of Shopee session, account and application data on device.</sys:String>
    <sys:String x:Key="Str.Backup.CreateBtn">Create New Backup</sys:String>
    <sys:String x:Key="Str.Backup.ExistingBackups">Saved Backups</sys:String>
    <sys:String x:Key="Str.Backup.RestoreBtn">Restore</sys:String>
    <sys:String x:Key="Str.Backup.DeleteBtn">Delete</sys:String>
    <sys:String x:Key="Str.Backup.OpenFolder">Open Folder</sys:String>
    <sys:String x:Key="Str.Backup.BackingUp">Backing up Shopee data...</sys:String>
    <sys:String x:Key="Str.Backup.Restoring">Restoring data to device...</sys:String>
    <sys:String x:Key="Str.Backup.Success">Backup completed ✓</sys:String>
    <sys:String x:Key="Str.Backup.RestoreSuccess">Restore completed ✓ Data &amp; SSAID restored.</sys:String>
    <sys:String x:Key="Str.Backup.NoBackups">No backups found. Click 'Create New Backup' to save current session.</sys:String>
    <sys:String x:Key="Str.Backup.ConfirmRestore">Are you sure you want to restore this backup?&#x0A;Current Shopee data on device will be replaced.</sys:String>
    <sys:String x:Key="Str.Backup.ConfirmDelete">Do you want to delete this backup?</sys:String>

