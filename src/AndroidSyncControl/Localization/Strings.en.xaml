    <sys:String x:Key="Str.Action.OpenShopee">Open Shopee</sys:String>
    <sys:String x:Key="Str.Action.BypassShopee">Bypass Shopee</sys:String>
    <sys:String x:Key="Str.Action.CheckUpdate">Check Update</sys:String>

    <!-- ================= Status Messages ================= -->
    <sys:String x:Key="Str.Status.Ready">Ready</sys:String>
    <sys:String x:Key="Str.Status.Done">Done ✓</sys:String>
    <sys:String x:Key="Str.Status.Copied">Copied (Ctrl+C) ✓</sys:String>
    <sys:String x:Key="Str.Status.SelectAll">Select All (Ctrl+A)</sys:String>
    <sys:String x:Key="Str.Status.EmptyClipboard">Clipboard empty</sys:String>
    <sys:String x:Key="Str.Status.NotConnected">Not connected</sys:String>
    <sys:String x:Key="Str.Status.Pasting">Pasting...</sys:String>
    <sys:String x:Key="Str.Status.Capturing">Capturing...</sys:String>
    <sys:String x:Key="Str.Status.Rebooting">Rebooting...</sys:String>
    <sys:String x:Key="Str.Status.Installing">Installing...</sys:String>
    <sys:String x:Key="Str.Status.InstallingApk">Installing {0} ({1:F1} MB)...</sys:String>
    <sys:String x:Key="Str.Status.InstallSuccess">Install succeeded ✓</sys:String>
    <sys:String x:Key="Str.Status.InstallFailed">Install failed: {0}</sys:String>
    <sys:String x:Key="Str.Status.OpeningShopee">Opening Shopee...</sys:String>
    <sys:String x:Key="Str.Status.RotatingIp">Rotating IP...</sys:String>
    <sys:String x:Key="Str.Status.ProxyCleared">Proxy cleared ✓</sys:String>
    <sys:String x:Key="Str.Status.AdbShellOpening">Opening ADB Shell...</sys:String>

    <!-- ================= Dialogs ================= -->
    <sys:String x:Key="Str.Dialog.RebootConfirm">Reboot device?</sys:String>
    <sys:String x:Key="Str.Dialog.ProxyEmptyPrompt">Host:port (empty to clear):</sys:String>
    <sys:String x:Key="Str.Dialog.ProxyCurrentPrompt">Proxy: {0}&#x0A;New host:port:</sys:String>
    <sys:String x:Key="Str.Dialog.Apply">Apply</sys:String>

