    <sys:String x:Key="Str.Adb.Title">ADB Smart Console &amp; Automation</sys:String>
    <sys:String x:Key="Str.Adb.Subtitle">Execute shell commands and automation scripts on Android device</sys:String>
    <sys:String x:Key="Str.Adb.RunBtn">Run Command</sys:String>
    <sys:String x:Key="Str.Adb.ClearBtn">Clear Console</sys:String>
    <sys:String x:Key="Str.Adb.OpenCmdBtn">Open CMD Shell</sys:String>
    <sys:String x:Key="Str.Adb.CopyBtn">Copy Output</sys:String>
    <sys:String x:Key="Str.Adb.PresetLabel">Quick Presets &amp; Scripts:</sys:String>
    <sys:String x:Key="Str.Adb.Running">Executing shell command...</sys:String>
    <sys:String x:Key="Str.Adb.Completed">Command completed ✓</sys:String>

    <!-- ================= Shopee Bypass Steps ================= -->
    <sys:String x:Key="Str.Bypass.Step1">[1/8] Clearing Shopee session...</sys:String>
    <sys:String x:Key="Str.Bypass.Step2">[2/8] Rotating Android ID...</sys:String>
    <sys:String x:Key="Str.Bypass.Step3">[3/8] Resetting Google Ads ID...</sys:String>
    <sys:String x:Key="Str.Bypass.Step4">[4/8] Clearing GSF ID...</sys:String>
    <sys:String x:Key="Str.Bypass.Step5">[5/8] Removing account tokens...</sys:String>
    <sys:String x:Key="Str.Bypass.Step6">[6/8] Disconnecting network...</sys:String>
    <sys:String x:Key="Str.Bypass.Step7">[7/8] Waiting for new IP...</sys:String>
    <sys:String x:Key="Str.Bypass.Step8">[8/8] Launching Shopee...</sys:String>
    <sys:String x:Key="Str.Bypass.Done">Bypass completed ✓</sys:String>

