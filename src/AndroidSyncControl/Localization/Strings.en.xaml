    <!-- Theme -->
    <sys:String x:Key="Str.Theme.Light">Light</sys:String>
    <sys:String x:Key="Str.Theme.Dark">Dark</sys:String>
    <sys:String x:Key="Str.Theme.System">System</sys:String>

    <!-- ================= Connection Screen & States ================= -->
    <sys:String x:Key="Str.Connect.Title">Connect Device</sys:String>
    <sys:String x:Key="Str.Connect.Detail">Connect via USB and enable USB debugging.</sys:String>
    <sys:String x:Key="Str.Connect.InitDetail">Initializing ADB daemon...</sys:String>
    <sys:String x:Key="Str.Connect.Initializing">Initializing...</sys:String>
    <sys:String x:Key="Str.Connect.Searching">Searching for device...</sys:String>
    <sys:String x:Key="Str.Connect.Connecting">Connecting...</sys:String>
    <sys:String x:Key="Str.Connect.Connected">Connected</sys:String>
    <sys:String x:Key="Str.Connect.Disconnected">Disconnected</sys:String>
    <sys:String x:Key="Str.Connect.Reconnecting">Reconnecting...</sys:String>
    <sys:String x:Key="Str.Connect.AdbUnavailable">ADB Unavailable</sys:String>
    <sys:String x:Key="Str.Connect.AdbError">ADB Error</sys:String>
    <sys:String x:Key="Str.Connect.NoDevice">No Device Connected</sys:String>

    <!-- ================= Sidebar Sections ================= -->
    <sys:String x:Key="Str.Sec.Device">DEVICE</sys:String>
    <sys:String x:Key="Str.Sec.Clipboard">PASTE</sys:String>
    <sys:String x:Key="Str.Sec.Files">FILES</sys:String>
    <sys:String x:Key="Str.Sec.Network">NETWORK</sys:String>
    <sys:String x:Key="Str.Sec.Shopee">SHOPEE</sys:String>
    <sys:String x:Key="Str.Sec.System">SYSTEM</sys:String>

    <!-- ================= Sidebar Actions ================= -->
    <sys:String x:Key="Str.Action.Info">Phone Info</sys:String>
    <sys:String x:Key="Str.Action.FitScreen">Fit Screen</sys:String>
    <sys:String x:Key="Str.Action.Power">Power</sys:String>
    <sys:String x:Key="Str.Action.Reboot">Reboot</sys:String>
    <sys:String x:Key="Str.Action.Screenshot">Screenshot</sys:String>
